{
  "manifest_version": 3,
  "name": "AI 书签整理助手",
  "version": "0.1.0",
  "homepage_url": "https://github.com/huhichao/ai-bookmark-organizer",
  "description": "使用 Chrome 内置 AI 或自定义大模型 API 分批整理书签：近期书签智能分类、历史书签自动归档、重复项清理，先预览后生效，支持一键撤销。",
  "minimum_chrome_version": "116",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*",
    "https://api.siliconflow.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 AI 书签整理助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
